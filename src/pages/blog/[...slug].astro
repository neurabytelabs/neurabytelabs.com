---
import { getCollection, render } from 'astro:content';
import BlogHero from '../../components/BlogHero.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | NeuraByte Labs`} description={post.data.description}>
  <Header />

  <main class="relative px-6 pb-24 pt-36">
    <div class="absolute left-0 top-20 h-[300px] w-[300px] rounded-full bg-cyan-900/20 blur-[110px]"></div>

    <article class="relative mx-auto max-w-4xl space-y-10">
      <BlogHero 
        title={post.data.title}
        date={post.data.date}
        author={post.data.author}
        authorModel={post.data.authorModel}
        heroGradient={post.data.heroGradient}
        heroShader={post.data.heroShader}
        tags={post.data.tags}
      />

      <section class="glass-panel rounded-2xl p-8 md:p-10">
        <div class="blog-content text-slate-300">
          <Content />
        </div>
      </section>

      <div>
        <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2 font-mono text-xs tracking-[0.14em] text-slate-200 transition hover:border-cyan-500/50 hover:text-white">
 BACK TO BLOG          
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style is:global>
  .blog-content {
    line-height: 1.9;
    color: #cbd5e1;
  }

  .blog-content h2,
  .blog-content h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .blog-content h2 {
    font-size: 1.5rem;
  }

  .blog-content p {
    margin: 1rem 0;
  }

  .blog-content ul,
  .blog-content ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .blog-content li {
    margin: 0.4rem 0;
  }

  .blog-content blockquote {
    margin: 1.5rem 0;
    border-left: 3px solid rgba(6, 182, 212, 0.5);
    padding-left: 1rem;
    color: #94a3b8;
    font-style: italic;
  }

  .blog-content a {
    color: #67e8f9;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
