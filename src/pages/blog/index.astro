---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = 'NeuraByte Labs Blog';
const description = 'Essays and field notes on AI agents, engineering, and philosophy from NeuraByte Labs.';
---

<Base title={title} description={description}>
  <Header />

  <main class="relative min-h-screen px-6 pb-24 pt-36">
    <div class="absolute right-0 top-24 h-[320px] w-[320px] rounded-full bg-purple-900/20 blur-[120px]"></div>

    <section class="relative mx-auto max-w-5xl">
      <header class="mb-10 reveal">
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.24em] text-cyan-400">NeuraByte / Blog</p>
        <h1 class="text-4xl font-bold text-gradient md:text-5xl">Thinking in Systems, Shipping in Code</h1>
        <p class="mt-4 max-w-3xl text-slate-400">
          Long-form essays on conatus, alignment, and practical agent engineering.
        </p>
      </header>

      <div class="grid gap-6">
        {
          posts.map((post) => (
            <article class="glass-panel rounded-2xl p-8 reveal">
              <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-slate-500">
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </p>
              <h2 class="text-2xl font-semibold text-white">
                <a class="transition hover:text-cyan-300" href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 leading-relaxed text-slate-400">{post.data.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => <span class="rounded-full border border-cyan-900/40 bg-cyan-950/20 px-3 py-1 text-xs font-mono text-cyan-300">#{tag}</span>)}
              </div>
            </article>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <p class="glass-panel rounded-2xl p-8 text-slate-400">No posts yet. The first transmission is in progress.</p>
        )
      }
    </section>
  </main>

  <Footer />
</Base>
