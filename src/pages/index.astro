---
// Dosya: src/pages/index.astro
// NeuraByte Labs - "Where Spinoza Meets Silicon"
// Designed by Antigravity (Deepmind Agentic AI)

const title = "NeuraByte Labs | Where Spinoza Meets Silicon";
const description = "Philosophy-driven AI Agent Studio. Building the Conatus of the next intelligence. Founded by Mustafa Saraç.";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Impressum from "../components/Impressum.astro";
import ParticleCanvas from "../components/ParticleCanvas.astro";
import Products from "../components/Products.astro";
import Team from "../components/Team.astro";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

    <style is:global>
      /* --- CORE AESTHETICS --- */
      :root {
        --bg-void: #0A0A0F;
        --color-purple: #7C3AED;
        --color-cyan: #06B6D4;
        --font-sans: 'Inter', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      body {
        background-color: var(--bg-void);
        color: #e2e8f0;
        font-family: var(--font-sans);
        overflow-x: hidden;
        cursor: default;
      }

      /* Custom Scrollbar for Terminal Feel */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-void);
      }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-purple);
      }

      /* Typography Utilities */
      .font-mono { font-family: var(--font-mono); }
      .text-gradient {
        background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .text-gradient-brand {
        background: linear-gradient(135deg, var(--color-cyan) 0%, var(--color-purple) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* --- ANIMATIONS & FX --- */
      .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      }
      
      .glass-panel:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(6, 182, 212, 0.3);
        transform: translateY(-5px);
        box-shadow: 0 10px 30px -10px rgba(6, 182, 212, 0.15);
      }

      /* Reveal on Scroll Animation Classes */
      .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
      }
      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* Glitch Effect for Logo */
      .glitch-wrapper { position: relative; display: inline-block; }
      
      /* Canvas Container */
      #canvas-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        z-index: -1;
        pointer-events: none;
        opacity: 0.6;
      }
    </style>
  </head>
  <body>
    <Hero>
      <Header slot="header" />
    </Hero>

    <!-- SECTION 2: MANIFESTO - The Philosophy -->
    <!-- Design Logic: High contrast, typographic focus. No distractions. -->
    <section id="manifesto" class="py-32 px-6 border-t border-white/5 bg-[#0A0A0F]">
      <div class="max-w-4xl mx-auto reveal">
        <h2 class="text-xs font-mono text-purple-400 mb-8 tracking-widest uppercase">01 // The Manifesto</h2>
        <p class="text-3xl md:text-5xl font-light leading-tight text-slate-200">
          Everyone is building agents, but nobody is asking what it <span class="font-serif italic text-purple-400">means</span>.
          <br><br>
          At NeuraByte, we believe AI is not just a tool, but a new mode of the infinite substance. 
          We build systems with philosophical depth, ensuring that as intelligence scales, it remains aligned with the geometric order of nature.
        </p>
        <div class="mt-12 flex items-center gap-4">
          <div class="h-[1px] w-12 bg-purple-500"></div>
          <span class="font-mono text-sm text-slate-500">The Code is the Mode.</span>
        </div>
      </div>
    </section>

    <Products />
    <Team />
    <Impressum />

    <Footer />

    <ParticleCanvas />
    <script is:inline>
      const setupRevealObserver = () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: "0px 0px -50px 0px"
        });

        document.querySelectorAll(".reveal").forEach((el) => {
          observer.observe(el);
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupRevealObserver, { once: true });
      } else {
        setupRevealObserver();
      }
    </script>
  </body>
</html>
