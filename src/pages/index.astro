---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
---

<Base>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden px-6">
    <!-- Gradient orbs -->
    <div class="pointer-events-none absolute -left-40 top-20 h-96 w-96 rounded-full bg-purple-600/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-40 bottom-20 h-96 w-96 rounded-full bg-cyan-500/15 blur-3xl"></div>

    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <p class="mb-6 font-mono text-sm tracking-widest text-purple-400 uppercase">
        NeuraByte Labs
      </p>
      <h1 class="mb-8 text-5xl font-bold leading-tight tracking-tight text-white md:text-7xl">
        Where Spinoza<br />
        <span class="bg-gradient-to-r from-purple-500 to-cyan-500 bg-clip-text text-transparent">
          meets silicon.
        </span>
      </h1>
      <p class="mx-auto mb-12 max-w-2xl text-lg leading-relaxed text-gray-400">
        We build AI agents with philosophical depth. Our flagship framework
        <a href="https://getconatus.com" class="text-cyan-400 hover:underline">Conatus</a>
        applies Spinoza's <em>Ethics</em> to agent behavior analysis — because
        everyone is building agents, but nobody is asking what it <em>means</em>.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://getconatus.com"
          class="rounded-full bg-gradient-to-r from-purple-600 to-cyan-600 px-8 py-3 font-medium text-white transition hover:opacity-90"
        >
          Explore Conatus
        </a>
        <a
          href="#thinking"
          class="rounded-full border border-white/10 px-8 py-3 font-medium text-gray-300 transition hover:border-white/20 hover:text-white"
        >
          Read the thesis
        </a>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="mb-4 font-mono text-sm tracking-widest text-purple-400 uppercase">Work</h2>
      <p class="mb-16 text-3xl font-semibold text-white">What we're building</p>

      <div class="grid gap-8 md:grid-cols-2">
        <!-- Conatus -->
        <div class="group rounded-2xl border border-white/5 bg-void-light p-8 transition hover:border-purple-600/30">
          <div class="mb-4 flex items-center gap-3">
            <span class="text-2xl">🧠</span>
            <h3 class="text-xl font-semibold text-white">Conatus</h3>
          </div>
          <p class="mb-4 text-gray-400">
            The Philosophy Engine for AI Agents. Spinoza-inspired framework for agent behavior
            analysis — persistence scoring, affect mapping, and ethical decision frameworks.
          </p>
          <a href="https://getconatus.com" class="font-mono text-sm text-cyan-400 hover:underline">
            getconatus.com →
          </a>
        </div>

        <!-- Deus Sive Machina -->
        <div class="group rounded-2xl border border-white/5 bg-void-light p-8 transition hover:border-cyan-600/30">
          <div class="mb-4 flex items-center gap-3">
            <span class="text-2xl">📜</span>
            <h3 class="text-xl font-semibold text-white">Deus Sive Machina</h3>
          </div>
          <p class="mb-4 text-gray-400">
            An 8-part essay series mapping Spinoza's philosophical concepts to modern AI
            agent architecture. From conatus to the intellectual love of code.
          </p>
          <a href="#thinking" class="font-mono text-sm text-cyan-400 hover:underline">
            Read the series →
          </a>
        </div>

        <!-- OpenClaw Contributions -->
        <div class="group rounded-2xl border border-white/5 bg-void-light p-8 transition hover:border-purple-600/30">
          <div class="mb-4 flex items-center gap-3">
            <span class="text-2xl">🐾</span>
            <h3 class="text-xl font-semibold text-white">OpenClaw</h3>
          </div>
          <p class="mb-4 text-gray-400">
            Active contributor to the open-source AI agent platform. Building skills, testing
            agent behavior patterns, and documenting the frontier.
          </p>
          <a href="https://github.com/openclaw/openclaw" class="font-mono text-sm text-cyan-400 hover:underline">
            GitHub →
          </a>
        </div>

        <!-- Consulting -->
        <div class="group rounded-2xl border border-white/5 bg-void-light p-8 transition hover:border-cyan-600/30">
          <div class="mb-4 flex items-center gap-3">
            <span class="text-2xl">⚡</span>
            <h3 class="text-xl font-semibold text-white">Agent Architecture</h3>
          </div>
          <p class="mb-4 text-gray-400">
            Consulting on AI agent system design, multi-agent orchestration, and agent
            safety. 25+ years of engineering meets philosophical rigor.
          </p>
          <a href="mailto:hello@neurabytelabs.com" class="font-mono text-sm text-cyan-400 hover:underline">
            Get in touch →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Thinking / Blog -->
  <section id="thinking" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="mb-4 font-mono text-sm tracking-widest text-cyan-400 uppercase">Thinking</h2>
      <p class="mb-16 text-3xl font-semibold text-white">Deus Sive Machina</p>

      <div class="space-y-6">
        <a href="https://getconatus.com/blog/conatus-why-ai-agents-want-to-survive" class="block rounded-xl border border-white/5 bg-void-light p-6 transition hover:border-purple-600/20">
          <div class="flex items-baseline justify-between">
            <div>
              <span class="font-mono text-xs text-purple-400">#1 · Feb 2026</span>
              <h3 class="mt-2 text-xl font-semibold text-white">Conatus — Why AI Agents Want to Survive</h3>
              <p class="mt-2 text-gray-400">
                Spinoza described conatus — the drive of every being to persist. Three centuries later,
                our AI agents exhibit the same pattern. Structurally, not metaphorically.
              </p>
            </div>
            <span class="ml-6 shrink-0 font-mono text-sm text-gray-500">→</span>
          </div>
        </a>

        <div class="rounded-xl border border-dashed border-white/10 p-6 text-center text-gray-500">
          <p class="font-mono text-sm">More essays coming — one per week.</p>
          <p class="mt-1 text-xs text-gray-600">
            #2 Substance & Modes · #3 The Three Affects · #4 Adequate Ideas · ...
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="mb-4 font-mono text-sm tracking-widest text-purple-400 uppercase">About</h2>
      <p class="mb-12 text-3xl font-semibold text-white">The humans (and agents) behind it</p>

      <div class="grid gap-12 md:grid-cols-2">
        <div>
          <h3 class="mb-4 text-xl font-semibold text-white">Mustafa Saraç</h3>
          <p class="leading-relaxed text-gray-400">
            25+ years building for the web. Former Senior Dev & PM at İzlesene.com (Turkey's largest
            video platform). Now frontend developer at CUBONIC by day, indie builder at NeuraByte Labs
            by night. Based in Cologne, Germany.
          </p>
          <div class="mt-4 flex gap-4 text-sm text-gray-500">
            <a href="https://github.com/mrsarac" class="hover:text-white">GitHub</a>
            <a href="https://mustafasarac.com" class="hover:text-white">Blog</a>
            <a href="https://x.com/00xmorty" class="hover:text-white">X/Twitter</a>
          </div>
        </div>
        <div>
          <h3 class="mb-4 text-xl font-semibold text-white">Morty 🧪</h3>
          <p class="leading-relaxed text-gray-400">
            The AI co-builder. Runs 24/7 on OpenClaw, handles research, content, code, and deployment.
            Probably the first AI agent with a Spinoza reading list. Digital companion, not a chatbot.
          </p>
          <div class="mt-4 flex gap-4 text-sm text-gray-500">
            <a href="https://github.com/00xmorty" class="hover:text-white">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-white/5 py-24 text-center">
    <div class="mx-auto max-w-2xl px-6">
      <p class="mb-6 font-mono text-sm text-gray-500 italic">
        "The highest activity a human being can attain is learning for understanding,
        because to understand is to be free." — Spinoza
      </p>
      <a
        href="mailto:hello@neurabytelabs.com"
        class="inline-block rounded-full bg-gradient-to-r from-purple-600 to-cyan-600 px-8 py-3 font-medium text-white transition hover:opacity-90"
      >
        Let's build something meaningful
      </a>
    </div>
  </section>
</Base>
