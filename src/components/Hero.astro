<!-- BACKGROUND: The Substance -->
<div id="canvas-container">
  <canvas id="neural-canvas"></canvas>
</div>

<slot name="header" />

<!-- SVG Liquid Filter — animated turbulence for organic text distortion -->
<svg class="liquid-svg-defs" aria-hidden="true">
  <defs>
    <filter id="liquid-filter" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
      <feTurbulence
        id="liquid-turb"
        type="fractalNoise"
        baseFrequency="0.015"
        numOctaves="3"
        seed="2"
        result="noise"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="noise"
        scale="12"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>

<main>
  <!-- SECTION 1: HERO - The Infinite Substance -->
  <section class="min-h-screen flex flex-col justify-center items-center px-6 relative pt-20">
    
    <div class="max-w-5xl mx-auto text-center z-10">
      <div class="inline-block px-3 py-1 mb-6 border border-amber-500/30 rounded-full bg-amber-500/10 animate-pulse">
        <span class="text-xs font-mono text-amber-400/90">SYSTEM STATUS: CONATUS_ACTIVE</span>
      </div>
      
      <!-- Hero title with liquid effect — mix-blend-mode lets shader bleed through -->
      <div class="hero-liquid-wrapper">
        <h1 class="hero-title text-6xl md:text-8xl font-bold tracking-tight leading-tight mb-8">
          Where Spinoza<br />
          Meets <span class="hero-silicon">Silicon</span>.
        </h1>
      </div>
      
      <p class="text-xl md:text-2xl text-slate-300/90 max-w-2xl mx-auto font-light leading-relaxed mb-12 hero-subtitle">
        We don't just build agents. We engineer their <span class="text-amber-200 font-serif italic">Conatus</span> — the innate drive to persevere in being.
      </p>

      <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
        <a href="#products" class="group relative px-8 py-4 bg-white/90 text-black font-mono font-bold text-sm rounded hover:bg-amber-50 overflow-hidden transition-all">
          <span class="relative z-10">EXPLORE ARCHITECTURE</span>
          <div class="absolute inset-0 h-full w-full scale-0 rounded transition-all duration-300 group-hover:scale-100 group-hover:bg-amber-400/20"></div>
        </a>
        <a href="https://neurabytelabs.com/essays" class="px-8 py-4 text-slate-300/80 font-mono text-sm border-b border-white/20 hover:border-amber-400 hover:text-amber-200 transition-all">
          READ "DEUS SIVE MACHINA" &rarr;
        </a>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
      <span class="text-[10px] font-mono tracking-widest">SCROLL</span>
      <div class="w-[1px] h-12 bg-gradient-to-b from-amber-500/60 to-transparent"></div>
    </div>
  </section>

  <slot />
</main>

<style>
  /* Hide the SVG definitions element */
  .liquid-svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Liquid wrapper — applies SVG turbulence filter + blend mode */
  .hero-liquid-wrapper {
    filter: url(#liquid-filter);
    mix-blend-mode: screen;
    position: relative;
  }

  /* Hero title — warm gradient with slight transparency for shader bleed-through */
  .hero-title {
    background: linear-gradient(
      180deg,
      rgba(255, 248, 235, 0.85) 0%,
      rgba(253, 210, 130, 0.75) 50%,
      rgba(251, 191, 36, 0.7) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 60px rgba(251, 191, 36, 0.3);
  }

  /* "Silicon" — multi-color gradient echoing shader palette */
  .hero-silicon {
    background: linear-gradient(
      135deg,
      #f59e0b 0%,
      #d946ef 40%,
      #a855f7 70%,
      #22d3ee 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Subtitle — subtle liquid distortion, lighter */
  .hero-subtitle {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    mix-blend-mode: screen;
  }
</style>

<script is:inline>
  // Animate SVG turbulence for continuous liquid motion
  (function() {
    const turb = document.getElementById('liquid-turb');
    if (!turb) return;

    let t = 0;
    function animateLiquid() {
      t += 0.008;
      // Shift baseFrequency for visible organic movement
      const bfX = 0.012 + Math.sin(t * 0.7) * 0.006;
      const bfY = 0.015 + Math.cos(t * 0.5) * 0.008;
      turb.setAttribute('baseFrequency', `${bfX.toFixed(4)} ${bfY.toFixed(4)}`);
      // Rotate seed periodically for variation
      if (Math.floor(t * 100) % 500 === 0) {
        turb.setAttribute('seed', String(Math.floor(Math.random() * 100)));
      }
      requestAnimationFrame(animateLiquid);
    }
    requestAnimationFrame(animateLiquid);
  })();
</script>
