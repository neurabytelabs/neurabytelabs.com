---
interface Props {
  title: string;
  date: Date;
  author: string;
  authorModel?: string;
  heroGradient?: string;
  tags?: string[];
}

const { title, date, author, authorModel, heroGradient = 'purple', tags = [] } = Astro.props;

const gradients: Record<string, { from: string; to: string; particle: string }> = {
  purple: { from: '#7C3AED', to: '#06B6D4', particle: 'rgba(124, 58, 237,' },
  cyan: { from: '#06B6D4', to: '#3B82F6', particle: 'rgba(6, 182, 212,' },
  amber: { from: '#F59E0B', to: '#EF4444', particle: 'rgba(245, 158, 11,' },
};

const g = gradients[heroGradient] || gradients.purple;
const heroId = `hero-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="blog-hero-wrapper" style="position: relative; overflow: hidden; border-radius: 1rem; margin-bottom: 3rem; min-height: 360px;">
  <canvas id={heroId} style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;"></canvas>
  
  <!-- Vortex overlay gradient -->
  <div style={`position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, transparent 20%, ${g.from}22 50%, #0A0A0F 90%); z-index: 1;`}></div>
  
  <div style="position: relative; z-index: 2; padding: 3rem 2rem; display: flex; flex-direction: column; justify-content: flex-end; min-height: 360px;">
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
      {tags.map(tag => (
        <span style={`padding: 0.25rem 0.75rem; font-size: 0.7rem; font-family: 'JetBrains Mono', monospace; background: ${g.from}22; border: 1px solid ${g.from}44; border-radius: 9999px; color: ${g.from};`}>#{tag}</span>
      ))}
    </div>
    
    <h1 style={`font-size: 2.5rem; font-weight: 800; line-height: 1.1; margin-bottom: 1rem; background: linear-gradient(135deg, #fff 0%, ${g.to} 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;`}>
      {title}
    </h1>
    
    <div style="display: flex; align-items: center; gap: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #94a3b8;">
      <span>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      <span style="opacity: 0.3;">|</span>
      <span>{author}</span>
      {authorModel && (
        <span style={`padding: 0.15rem 0.5rem; font-size: 0.65rem; background: ${g.from}33; border: 1px solid ${g.from}55; border-radius: 4px; color: ${g.from};`}>{authorModel}</span>
      )}
    </div>
  </div>
</div>

<script define:vars={{ heroId, fromColor: g.from, toColor: g.to, particleBase: g.particle }}>
  (function() {
    const canvas = document.getElementById(heroId);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, particles = [], center, time = 0;
    
    function resize() {
      const rect = canvas.parentElement.getBoundingClientRect();
      w = canvas.width = rect.width;
      h = canvas.height = rect.height;
      center = { x: w * 0.7, y: h * 0.5 };
    }
    
    class Particle {
      constructor() { this.reset(); }
      reset() {
        this.angle = Math.random() * Math.PI * 2;
        this.radius = 30 + Math.random() * Math.min(w, h) * 0.4;
        this.speed = (0.002 + Math.random() * 0.008) * (Math.random() > 0.5 ? 1 : -1);
        this.size = Math.random() * 2.5 + 0.5;
        this.opacity = Math.random() * 0.8 + 0.2;
        this.drift = (Math.random() - 0.5) * 0.3;
      }
      update() {
        this.angle += this.speed;
        this.radius += this.drift;
        if (this.radius < 5 || this.radius > Math.min(w, h) * 0.6) this.reset();
        this.x = center.x + Math.cos(this.angle) * this.radius;
        this.y = center.y + Math.sin(this.angle) * this.radius * 0.6;
      }
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = particleBase + this.opacity + ')';
        ctx.fill();
      }
    }
    
    function init() {
      resize();
      particles = Array.from({ length: 120 }, () => new Particle());
    }
    
    function animate() {
      ctx.clearRect(0, 0, w, h);
      time += 0.01;
      
      // Draw vortex glow
      const gradient = ctx.createRadialGradient(center.x, center.y, 10, center.x, center.y, 200);
      gradient.addColorStop(0, fromColor + '15');
      gradient.addColorStop(0.5, toColor + '08');
      gradient.addColorStop(1, 'transparent');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, w, h);
      
      // Draw connections between nearby particles
      for (let i = 0; i < particles.length; i++) {
        particles[i].update();
        particles[i].draw();
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 80) {
            ctx.beginPath();
            ctx.strokeStyle = particleBase + (0.15 * (1 - dist / 80)) + ')';
            ctx.lineWidth = 0.5;
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }
      
      requestAnimationFrame(animate);
    }
    
    init();
    animate();
    window.addEventListener('resize', () => { resize(); });
  })();
</script>
