---
/**
 * BlogHero — Dynamic shader hero for each blog post.
 * Each post has a unique WebGL shader created by its author agent.
 */
interface Props {
  title: string;
  date: Date;
  author: string;
  authorModel?: string;
  heroGradient?: string;
  heroShader?: string;
  tags?: string[];
}

const { title, date, author, authorModel, heroGradient = 'purple', heroShader = 'default', tags = [] } = Astro.props;

const gradients: Record<string, { from: string; to: string }> = {
  purple: { from: '#A855F7', to: '#22D3EE' },
  cyan: { from: '#22D3EE', to: '#3B82F6' },
  amber: { from: '#F59E0B', to: '#EF4444' },
};

const g = gradients[heroGradient] || gradients.purple;
const heroId = `hero-${Math.random().toString(36).slice(2, 8)}`;

// Read shader files at build time
import { readFileSync } from 'fs';
import { resolve } from 'path';

const shadersDir = resolve(process.cwd(), 'public/shaders');
const engineCode = readFileSync(resolve(shadersDir, '_engine.js'), 'utf-8');
const shaderFile = ['conatus', 'geometry', 'building', 'substance'].includes(heroShader) 
  ? `${heroShader}.js` 
  : 'default.js';
const shaderCode = readFileSync(resolve(shadersDir, shaderFile), 'utf-8');
---

<div class="blog-hero-wrapper" id={`wrapper-${heroId}`} style="position: relative; overflow: hidden; border-radius: 1rem; margin-bottom: 3rem; min-height: 380px; cursor: crosshair;">
  <canvas id={heroId} style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;"></canvas>
  
  <div style={`position: absolute; inset: 0; background: linear-gradient(180deg, transparent 0%, #050508AA 50%, #050508DD 100%); z-index: 1;`}></div>
  <div style={`position: absolute; inset: 0; background: radial-gradient(ellipse at 60% 20%, ${g.from}15 0%, transparent 60%); z-index: 1;`}></div>
  
  <div style="position: relative; z-index: 2; padding: 3rem 2rem; display: flex; flex-direction: column; justify-content: flex-end; min-height: 380px;">
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem;">
      {tags.map(tag => (
        <span style={`padding: 0.25rem 0.75rem; font-size: 0.7rem; font-family: 'JetBrains Mono', monospace; background: ${g.from}22; border: 1px solid ${g.from}44; border-radius: 9999px; color: ${g.from};`}>#{tag}</span>
      ))}
    </div>
    
    <h1 style={`font-size: 2.5rem; font-weight: 800; line-height: 1.1; margin-bottom: 1rem; background: linear-gradient(135deg, #fff 0%, ${g.to} 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;`}>
      {title}
    </h1>
    
    <div style="display: flex; align-items: center; gap: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: #94a3b8;">
      <span>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      <span style="opacity: 0.3;">|</span>
      <span>{author}</span>
      {authorModel && (
        <span style={`padding: 0.15rem 0.5rem; font-size: 0.65rem; background: ${g.from}33; border: 1px solid ${g.from}55; border-radius: 4px; color: ${g.from};`}>{authorModel}</span>
      )}
    </div>
  </div>
</div>

<script is:inline define:vars={{ heroId, engineCode, shaderCode }}>
  window.__HERO_ID = heroId;
  // Inject engine
  eval(engineCode);
  // Inject shader (calls initBlogShader)
  eval(shaderCode);
</script>
